# AgroArc backend environment template.
# Copy to backend/.env and fill in real values. NEVER commit the populated file.
# (backend/.env is already covered by .gitignore.)
#
# In production (e.g. Heroku) set these as platform config vars instead of a
# file:  heroku config:set OPENWEATHER_API_KEY=... -a <app>

# --- Secrets (required) -----------------------------------------------------

# OpenWeatherMap API key — sign up at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application config (optional, sensible defaults shown) ------------------

# Gemini model to use. Pick one your key has free quota for.
# Verified working: gemini-2.5-flash, gemini-2.0-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# CORS allowlist. "*" allows any origin (local dev only). In production set a
# comma-separated list of exact frontend origins, e.g.:
#   ALLOWED_ORIGINS=https://agroarc-web.herokuapp.com,https://agroarc.com
ALLOWED_ORIGINS=*

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
