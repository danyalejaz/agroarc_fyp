# AgroArc frontend environment template.
# Copy to frontend/.env.local for local dev, or set as a build arg in Docker/CI.
# Vite only exposes variables prefixed with VITE_ to the browser bundle, so
# NEVER put real secrets (API keys, tokens) here — anything here ships to the
# client and is publicly visible.

# Base URL of the AgroArc backend API.
# Local dev default:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production example (set at build time):
# VITE_API_BASE_URL=https://agroarc-api.herokuapp.com
